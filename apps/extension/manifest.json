{
  "manifest_version": 3,
  "name": "AI-buddy Demo",
  "version": "0.2.0",
  "minimum_chrome_version": "116",
  "description": "Демо-помощник онбординга в боковой панели. Работает только с локальным Backend.",
  "background": {"service_worker": "background.js"},
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "action": {
    "default_title": "Открыть AI-buddy"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "host_permissions": [
    "http://127.0.0.1:8080/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:8080"
  }
}
