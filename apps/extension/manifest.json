{
  "manifest_version": 3,
  "name": "AI-buddy Demo",
  "version": "0.3.0",
  "minimum_chrome_version": "116",
  "description": "Демо-помощник онбординга: персонаж Бади на страницах и боковая панель. Работает только с локальным Backend.",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "Открыть AI-buddy"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "host_permissions": [
    "http://127.0.0.1:8080/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:8080"
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
