# Copy to .env.load. Keep .env.load out of Git.
LOAD_DB_PASSWORD=replace_with_unique_load_database_password
LOAD_JWT_SECRET=replace_with_unique_random_secret_at_least_32_chars
LOAD_BACKEND_PORT=18080
LOAD_PROMETHEUS_PORT=19090
LOAD_GRAFANA_PORT=13000
LOAD_GRAFANA_ADMIN_USER=admin
LOAD_GRAFANA_ADMIN_PASSWORD=replace_with_unique_grafana_admin_password
# Password for synthetic load users; keep the same value on repeated seed runs.
LOAD_USER_PASSWORD=replace_with_unique_load_user_password
