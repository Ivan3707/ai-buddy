# Copy to .env and fill in secrets. Never commit .env. Host ports only.
WEB_PORT=5173
# If 8080 is busy (e.g. CVAT/traefik), use 18080 and build the extension with BACKEND_ORIGIN.
BACKEND_PORT=8080
# AI is internal to Docker. For standalone development:
# AI_URL=http://127.0.0.1:8001
DB_USER=app
DB_PASSWORD=replace_with_your_database_password
DB_NAME=app

JWT_SECRET=replace_with_random_secret_at_least_32_chars

# ---------------- AI / LLM (apps/ai) — see docs/specifications/002-ai-agent-chat.md ----------------
# mock = deterministic offline mode (tests, CI, no key); openai_compatible = any Chat Completions API
LLM_PROVIDER=mock
# Examples (pick one provider, set its key in LLM_API_KEY):
#   OpenAI:      LLM_BASE_URL=https://api.openai.com/v1
#   Gemini:      LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1
#   Ollama:      LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_BASE_URL=
LLM_API_KEY=
# Tested: openai/gpt-6.1-terra via OpenRouter (direct OpenAI: gpt-6.1-terra)
LLM_MODEL=
# Optional; empty = provider default (some reasoning models reject temperature)
LLM_TEMPERATURE=
# Optional JSON merged into the request body, provider-specific. OpenRouter: {"reasoning":{"effort":"low"}}
# (same quality on eval, faster first token); direct OpenAI: {"reasoning_effort":"low"}
LLM_EXTRA_BODY=
LLM_TIMEOUT_SECONDS=60
LLM_FIRST_BYTE_TIMEOUT_SECONDS=15
LLM_MAX_OUTPUT_TOKENS=1024
# Retrieval: chunks passed to the model; min relevance to answer instead of escalating
RAG_TOP_K=4
RAG_MIN_SCORE=0.2
