# Copy to .env: `cp .env.example .env` (PowerShell: Copy-Item .env.example .env). Never commit .env.
# These values work as is for a local demo stand. On a shared stand use your own random values.
DB_PASSWORD=demo_db_password_change_me
JWT_SECRET=demo_jwt_secret_change_me_0123456789abcdef
# Password of the demo accounts (README, «Тестовые учётки»)
DEMO_PASSWORD=AiBuddy2026

# LLM: mock = offline mode without a key. For a real model see README, «Подключение LLM», e.g.:
#   LLM_PROVIDER=openai_compatible
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=openai/gpt-6.1-terra
#   LLM_EXTRA_BODY={"reasoning":{"effort":"low"}}
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_EXTRA_BODY=

# Other settings (ports, RAG, limits, fallback model, Confluence) have defaults in compose.yaml
# and can be overridden here; the list is in README, «Настройки».
