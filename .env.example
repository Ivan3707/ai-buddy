# Copy to .env and replace both secret placeholders before bootstrap.
WEB_PORT=5173
BACKEND_PORT=8080
POSTGRES_PORT=5433
# AI is internal to Docker. For standalone development:
# AI_URL=http://127.0.0.1:8001
DB_USER=app
DB_PASSWORD=replace_with_your_database_password
DB_NAME=app

JWT_SECRET=replace_with_random_secret_at_least_32_chars
