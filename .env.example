# Copy to .env: `cp .env.example .env` (PowerShell: Copy-Item .env.example .env). Never commit .env.
# The values below are for a local demo stand with synthetic data and work as is. For any shared or
# public stand replace DB_PASSWORD, JWT_SECRET and DEMO_PASSWORD with your own random values.
WEB_PORT=5173
# If 8080 is busy (e.g. CVAT/traefik), use 18080 and build the extension with BACKEND_ORIGIN.
BACKEND_PORT=8080
POSTGRES_PORT=5433
# AI is internal to Docker. For standalone development:
# AI_URL=http://127.0.0.1:8001
DB_USER=app
DB_PASSWORD=demo_db_password_change_me
DB_NAME=app

JWT_SECRET=demo_jwt_secret_change_me_0123456789abcdef

# Demo accounts (data/corporate_employees.json) are created by the Compose service "init" with this password.
# Empty = no accounts are created automatically (use cmd/sync-hr -credentials for random passwords).
DEMO_PASSWORD=AiBuddy2026
# 1 = on a fresh database fill demo progress, a review, requests, a question, notes and events (cmd/seed-demo)
DEMO_SEED=1
# Demo only: open the /admin panel to every role (normally team lead only). Keep 0 for review.
ADMIN_OPEN_FOR_ALL=0

# ---------------- AI / LLM (apps/ai) — see docs/specifications/002-ai-agent-chat.md ----------------
# mock = deterministic offline mode (tests, CI, no key); openai_compatible = any Chat Completions API
LLM_PROVIDER=mock
# Examples (pick one provider, set its key in LLM_API_KEY):
#   OpenAI:      LLM_BASE_URL=https://api.openai.com/v1
#   Gemini:      LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1
#   Ollama:      LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_BASE_URL=
LLM_API_KEY=
# Tested: openai/gpt-6.1-terra via OpenRouter (direct OpenAI: gpt-6.1-terra); use it for tests and eval.
# Development (about 4x cheaper, replies in 2-3 s with reasoning off): qwen/qwen3.8-flash with
#   LLM_EXTRA_BODY={"reasoning":{"enabled":false}}   (terra: {"reasoning":{"effort":"low"}})
LLM_MODEL=
# Optional; empty = provider default (some reasoning models reject temperature)
LLM_TEMPERATURE=
# Optional JSON merged into the request body, provider-specific. OpenRouter: {"reasoning":{"effort":"low"}}
# (same quality on eval, faster first token); direct OpenAI: {"reasoning_effort":"low"}
LLM_EXTRA_BODY=
LLM_TIMEOUT_SECONDS=60
LLM_FIRST_BYTE_TIMEOUT_SECONDS=15
LLM_MAX_OUTPUT_TOKENS=1024
# Retrieval: chunks passed to the model; min relevance to answer instead of escalating
# hybrid = BM25 + embeddings (intfloat/multilingual-e5-small baked into the ai image, CPU); bm25 = lexical only
RAG_MODE=hybrid
RAG_TOP_K=4
RAG_MIN_SCORE=0.2
# Optional fallback LLM if the primary fails before answering (e.g. no internet at the demo).
# Tested 2026-11-13: local Ollama qwen3.5:4b answers from the KB well, but actions are unreliable
# (see apps/ai/eval/reports/local-models.md). From Docker use host.docker.internal.
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_EXTRA_BODY=
# KB lint (GET /v1/kb/lint): documents older than KB_STALE_DAYS are "stale"; KB_TODAY pins today (YYYY-MM-DD) for demos,
# empty = current date; at most KB_LINT_MAX_LLM_CALLS candidate pairs are judged by the LLM per lint run
KB_STALE_DAYS=365
KB_TODAY=
KB_LINT_MAX_LLM_CALLS=15
# KB source: markdown = data/kb/*.md (default); confluence = pages of one space via REST API v1 (Server/DC,
# personal access token sent as Bearer). POST /v1/kb/reload re-reads the source; KB_RELOAD_SECONDS > 0 also
# reloads periodically (0 = off)
KB_SOURCE=markdown
CONFLUENCE_URL=
CONFLUENCE_TOKEN=
CONFLUENCE_SPACE=
KB_RELOAD_SECONDS=0
# Demo wiki on the web app (/wiki/<id>.html, built from data/kb): source links in the chat open it.
KB_WIKI_URL=http://127.0.0.1:5173/wiki
# Limits: requests per minute per user (0 = off) and a daily token budget for the AI service (0 = off)
RATE_LIMIT_PER_MINUTE=20
LLM_DAILY_TOKEN_BUDGET=0
# Cache of frequent standalone KB questions (never personal answers or actions); 0 = off
ANSWER_CACHE_TTL_SECONDS=3600
