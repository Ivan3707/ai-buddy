{
  "uid": "ai-buddy-backend-performance",
  "title": "AI-Buddy — Backend Performance",
  "tags": [
    "ai-buddy",
    "load"
  ],
  "timezone": "browser",
  "schemaVersion": 40,
  "version": 4,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "method",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "ai-buddy-load-prometheus"
        },
        "query": {
          "query": "label_values(http_requests_total{job=\"ai-buddy-load-backend\",route!=\"GET /health\"}, method)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "route",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "ai-buddy-load-prometheus"
        },
        "query": {
          "query": "label_values(http_requests_total{job=\"ai-buddy-load-backend\",route!=\"GET /health\"}, route)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 13,
      "type": "row",
      "title": "Performance Overview",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 1,
      "title": "RPS — requests/sec",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ai-buddy-load-prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{method=~\"${method:regex}\",route=~\"${route:regex}\",route!=\"GET /health\"}[1m])) or vector(0)",
          "refId": "A",
          "legendFormat": "RPS — requests/sec"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "title": "HTTP 5xx error percentage",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ai-buddy-load-prometheus"
      },
      "targets": [
        {
          "expr": "100 * (sum(rate(http_requests_total{method=~\"${method:regex}\",route=~\"${route:regex}\",route!=\"GET /health\",status=~\"5..\"}[1m])) or vector(0)) / clamp_min(sum(rate(http_requests_total{method=~\"${method:regex}\",route=~\"${route:regex}\",route!=\"GET /health\"}[1m])) or vector(0), 1e-9)",
          "refId": "A",
          "legendFormat": "HTTP 5xx error percentage"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "Latency p95",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ai-buddy-load-prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{method=~\"${method:regex}\",route=~\"${route:regex}\",route!=\"GET /health\"}[1m])))",
          "refId": "A",
          "legendFormat": "Latency p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
