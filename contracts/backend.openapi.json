{
  "openapi": "3.1.0",
  "info": {
    "title": "AI-buddy backend",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8080"
    }
  ],
  "paths": {
    "/api/auth/refresh": {"post":{"operationId":"refreshSession","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["refresh_token"],"properties":{"refresh_token":{"type":"string"}}}}}},"responses":{"200":{"description":"Rotated tokens"},"401":{"description":"Invalid or replayed refresh token"}}}},
    "/api/auth/logout": {"post":{"operationId":"logoutSession","description":"Requires an access Bearer JWT and a refresh token in the body.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["refresh_token"],"properties":{"refresh_token":{"type":"string"}}}}}},"responses":{"204":{"description":"Session revoked"}}}},
    "/api/teamlead/interns/{internID}/checklist-items": {"post":{"operationId":"createPersonalTask","description":"Teamlead assigned to the intern inserts a personal item at a 1-based position in the professional checklist.","parameters":[{"name":"internID","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["position","title","expected_result","estimated_minutes","requires_review"],"properties":{"position":{"type":"integer","minimum":1},"title":{"type":"string"},"description":{"type":"string"},"expected_result":{"type":"string"},"estimated_minutes":{"type":"integer","minimum":1},"requires_review":{"type":"boolean"}}}}}},"responses":{"201":{"description":"Personal task created"},"400":{"description":"Invalid task or position"},"403":{"description":"Not teamlead"},"404":{"description":"Intern not assigned"}}}},
    "/api/progress": {"get":{"operationId":"getOwnOverallProgress","description":"Intern's combined common and professional progress, including personal items.","responses":{"200":{"description":"Overall progress with total_items, completed_items, completion_percent, common and professional checklists"},"403":{"description":"Not an intern"}}}},
    "/api/staff/interns/{internID}/progress": {"get":{"operationId":"getAssignedInternProgress","description":"Assigned buddy sees overall counts and both checklists; assigned teamlead sees professional counts and detail only.","parameters":[{"name":"internID","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Progress"},"403":{"description":"Not buddy or teamlead"},"404":{"description":"Intern not assigned"}}}},
    "/api/corporate/me": {"get":{"operationId":"getCorporateIdentity","description":"Synthetic HR identity matched by authenticated local email, role and profession.","responses":{"200":{"description":"Corporate employee"},"404":{"description":"Identity missing"},"503":{"description":"Mock unavailable"}}}},
    "/api/corporate/employees/{id}": {"get":{"operationId":"getCorporateEmployee","description":"Self or locally and corporately assigned intern only.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Corporate employee"},"404":{"description":"Not found or not assigned"}}}},
    "/api/corporate/tools/{tool}": {"get":{"operationId":"getCorporateToolInstructions","parameters":[{"name":"tool","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Permitted tool instructions and source"},"403":{"description":"Tool not permitted"},"503":{"description":"Mock unavailable"}}}},
    "/api/corporate/access-requests": {"post":{"operationId":"createCorporateAccessRequest","description":"Intern only. Confirmed user action; idempotency key is unique per user.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["tool","idempotency_key","confirm"],"properties":{"tool":{"type":"string"},"idempotency_key":{"type":"string","minLength":8,"maxLength":128},"confirm":{"type":"boolean","const":true}}}}}},"responses":{"201":{"description":"Created ticket with id, ticket_number, status and created_at"},"200":{"description":"Existing ticket for the same key"},"400":{"description":"Invalid input or missing confirmation"},"403":{"description":"Corporate permission denied"},"409":{"description":"Idempotency conflict"},"503":{"description":"Mock unavailable"}}},"get":{"operationId":"listOwnCorporateAccessRequests","responses":{"200":{"description":"Own tickets"},"503":{"description":"Mock unavailable"}}}},
    "/api/corporate/access-requests/{id}": {"get":{"operationId":"getOwnCorporateAccessRequest","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Own ticket"},"404":{"description":"Not found or foreign ticket"},"503":{"description":"Mock unavailable"}}}},
    "/api/hints": {"get":{"operationId":"listHints","responses":{"200":{"description":"Current user's generated hints","content":{"application/json":{"schema":{"type":"array","items":{"type":"object","required":["id","item_id","text","read_at","created_at"],"properties":{"id":{"type":"string","format":"uuid"},"item_id":{"type":"string","format":"uuid"},"text":{"type":"string"},"read_at":{"type":["string","null"],"format":"date-time"},"created_at":{"type":"string","format":"date-time"}}}}}}}}}},
    "/api/hints/{hintID}/read": {"post":{"operationId":"markHintRead","parameters":[{"name":"hintID","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"204":{"description":"Marked read"},"404":{"description":"Hint not found"}}}},
    "/api/checklist-items/{itemID}/hint": {"get":{"operationId":"getItemHint","parameters":[{"name":"itemID","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Generated hint"},"404":{"description":"Hint not found"}}}},
    "/api/notes": {"get":{"operationId":"listNotes","responses":{"200":{"description":"Owner's notes","content":{"application/json":{"schema":{"type":"array","items":{"type":"object","required":["id","title","content","updated_at"],"properties":{"id":{"type":"string","format":"uuid"},"title":{"type":"string"},"content":{"type":"string"},"updated_at":{"type":"string","format":"date-time"}}}}}}}}},"post":{"operationId":"createNote","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["title"],"properties":{"title":{"type":"string","minLength":1},"content":{"type":"string"}}}}}},"responses":{"201":{"description":"Note created"}}}},
    "/api/notes/{id}": {"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"get":{"operationId":"getNote","responses":{"200":{"description":"Note"},"404":{"description":"Not found"}}},"put":{"operationId":"updateNote","responses":{"200":{"description":"Updated note"},"404":{"description":"Not found"}}},"delete":{"operationId":"deleteNote","responses":{"204":{"description":"Deleted"},"404":{"description":"Not found"}}}},
    "/api/calendar/events": {"get":{"operationId":"listCalendarEvents","responses":{"200":{"description":"Owner's events"}}},"post":{"operationId":"createCalendarEvent","responses":{"201":{"description":"Event created"}}}},
    "/api/calendar/events/{id}": {"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"get":{"operationId":"getCalendarEvent","responses":{"200":{"description":"Event"},"404":{"description":"Not found"}}},"put":{"operationId":"updateCalendarEvent","responses":{"200":{"description":"Updated event"},"404":{"description":"Not found"}}},"delete":{"operationId":"deleteCalendarEvent","responses":{"204":{"description":"Deleted"},"404":{"description":"Not found"}}}},
    "/api/auth/login": {"post":{"operationId":"login","description":"Returns access_token, refresh_token, token_type, expires_in, is_first_login and user.","responses":{"200":{"description":"Authenticated"},"401":{"description":"Invalid credentials"}}}},
    "/api/auth/me": {"get":{"operationId":"currentUser","description":"Returns the current user, assigned buddy and teamlead profiles, age_years and tenure_months when source dates exist.","responses":{"200":{"description":"Current user"},"401":{"description":"Unauthorized"}}}},
    "/api/users": {"post":{"operationId":"createIntern","description":"Buddy creates an intern. Requires email, password, profession, first_name, last_name, department, team, teamlead_id, birth_date and employed_since. Dates use YYYY-MM-DD; telegram_username is optional. Existing users may have null dates or teamlead.","responses":{"201":{"description":"Created intern"},"400":{"description":"Invalid profile or assignment"},"403":{"description":"Invalid teamlead role"},"409":{"description":"Email already exists"}}}},
    "/api/buddy/interns/{internID}/teamlead": {"put":{"operationId":"assignTeamlead","description":"Assigned buddy may assign or replace a teamlead for an existing intern, including legacy rows.","parameters":[{"name":"internID","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["teamlead_id"],"properties":{"teamlead_id":{"type":"string","format":"uuid"}}}}}},"responses":{"204":{"description":"Assigned"},"400":{"description":"Invalid ID"},"403":{"description":"Target user is not a teamlead"},"404":{"description":"Intern not assigned or lead absent"}}}},
    "/api/checklists": {"get":{"operationId":"getChecklists","responses":{"200":{"description":"Intern's common and professional checklists"}}}},
    "/api/checklist-items/{itemID}/complete": {"post":{"operationId":"completeChecklistItem","parameters":[{"name":"itemID","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"204":{"description":"Completed"}}}},
    "/api/checklist-items/{itemID}/submissions": {"parameters":[{"name":"itemID","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"get":{"operationId":"getSubmissionHistory","responses":{"200":{"description":"Submission history"}}},"post":{"operationId":"submitChecklistItem","responses":{"201":{"description":"Submission created"}}}},
    "/api/buddy/submissions": {"get":{"operationId":"getBuddySubmissions","description":"Pending submissions of assigned interns, including first_name and last_name.","responses":{"200":{"description":"Pending submissions"}}}},
    "/api/buddy/submissions/{submissionID}/review": {"post":{"operationId":"reviewSubmission","parameters":[{"name":"submissionID","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"204":{"description":"Reviewed"}}}},
    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "mode"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    },
                    "mode": {
                      "type": "string",
                      "enum": [
                        "mock"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "operationId": "chat",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "502": {
            "description": "AI unavailable or invalid response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/onboarding": {
      "get": {
        "operationId": "onboarding",
        "parameters": [
          {
            "name": "role",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "ml",
                "backend",
                "frontend"
              ],
              "default": "ml"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "title",
                      "role",
                      "tasks"
                    ],
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "title": {
                        "type": "string"
                      },
                      "role": {
                        "type": "string",
                        "enum": [
                          "all",
                          "ml",
                          "backend",
                          "frontend"
                        ]
                      },
                      "tasks": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": [
                            "id",
                            "title"
                          ],
                          "properties": {
                            "id": {
                              "type": "string"
                            },
                            "title": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Unknown role",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Invalid demo data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "\\S"
          }
        }
      },
      "ChatResponse": {
        "type": "object",
        "required": [
          "answer",
          "sources",
          "mode"
        ],
        "properties": {
          "answer": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "title",
                "url"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                }
              }
            }
          },
          "mode": {
            "type": "string",
            "enum": [
              "mock"
            ]
          }
        }
      }
    }
  }
}
