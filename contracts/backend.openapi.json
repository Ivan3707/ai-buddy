{
  "openapi": "3.1.0",
  "info": {
    "title": "AI-buddy backend (public)",
    "version": "0.2.0",
    "description": "Auth and checklist endpoints are implemented in apps/backend and not yet listed here."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8080"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "mode"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    },
                    "mode": {
                      "type": "string",
                      "enum": [
                        "mock"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/onboarding": {
      "get": {
        "operationId": "onboarding",
        "parameters": [
          {
            "name": "role",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "ml",
                "backend",
                "frontend"
              ],
              "default": "ml"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "title",
                      "role",
                      "tasks"
                    ],
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "title": {
                        "type": "string"
                      },
                      "role": {
                        "type": "string",
                        "enum": [
                          "all",
                          "ml",
                          "backend",
                          "frontend"
                        ]
                      },
                      "tasks": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": [
                            "id",
                            "title"
                          ],
                          "properties": {
                            "id": {
                              "type": "string"
                            },
                            "title": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Unknown role",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Invalid demo data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "operationId": "chat",
        "deprecated": true,
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "Legacy non-streaming chat. Use /api/chat/stream.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "502": {
            "description": "AI unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/chat/stream": {
      "post": {
        "operationId": "chatStream",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "Streams the assistant answer. Backend: validates input, loads/creates conversation, builds verified UserContext, calls AI /v1/chat/stream, re-emits events, persists both messages, and converts the AI `action` (ActionProposal) into a stored PendingAction emitted as `action` (BackendActionEvent). First event is `meta`. Event data schemas: #/components/schemas/BackendStreamEvent.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StreamChatRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Event stream",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "Server-Sent Events stream. Each event is `event: <type>` + `data: <JSON>` where JSON matches the schema of the same `type`. Order: [meta] status* (delta | status)* [sources] [action] done | error. The stream always ends with exactly one `done` or `error` event."
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Conversation not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/chat/messages": {
      "get": {
        "operationId": "chatMessages",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "Messages of a conversation (default: the user's latest), oldest first.",
        "parameters": [
          {
            "name": "conversation_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "conversation_id",
                    "messages"
                  ],
                  "properties": {
                    "conversation_id": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ChatMessage"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/chat/messages/{id}/feedback": {
      "post": {
        "operationId": "chatFeedback",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Feedback"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Saved"
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/actions/{id}/confirm": {
      "post": {
        "operationId": "confirmAction",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "description": "Idempotent. Re-checks RBAC and params, executes once via the mock corporate service adapter. Repeated calls return the same result.",
        "responses": {
          "200": {
            "description": "Executed (or already executed)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActionResult"
                }
              }
            }
          },
          "404": {
            "description": "Not found / not owner",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Action cancelled",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Invalid params",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/actions/{id}/cancel": {
      "post": {
        "operationId": "cancelAction",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cancelled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PendingAction"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Already executed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/requests": {
      "get": {
        "operationId": "listRequests",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "Current user's requests in corporate services (mock), newest first.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ServiceRequest"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/requests/{id}": {
      "get": {
        "operationId": "getRequest",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceRequest"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/buddy/questions": {
      "get": {
        "operationId": "buddyQuestions",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "Buddy only: questions escalated by the buddy's interns.",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "open",
                "answered"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MentorQuestion"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Not a buddy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/buddy/questions/{id}/answer": {
      "post": {
        "operationId": "answerQuestion",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnswerMentorQuestion"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Answered",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MentorQuestion"
                }
              }
            }
          },
          "403": {
            "description": "Not this buddy's intern",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/metrics/chat": {
      "get": {
        "operationId": "chatMetrics",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "Buddy only: aggregated assistant metrics for own interns.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatMetrics"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ChatRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "\\S"
          }
        }
      },
      "ChatResponse": {
        "type": "object",
        "required": [
          "answer",
          "sources",
          "mode"
        ],
        "properties": {
          "answer": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Source"
            }
          },
          "mode": {
            "$ref": "#/components/schemas/AiMode"
          }
        }
      },
      "AiMode": {
        "type": "string",
        "enum": [
          "mock",
          "llm"
        ],
        "description": "mock = deterministic offline mode (tests/CI/no key); llm = real model"
      },
      "Source": {
        "type": "object",
        "required": [
          "id",
          "title",
          "url"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "snippet": {
            "type": "string",
            "description": "Short quote used for the answer"
          }
        }
      },
      "ActionType": {
        "type": "string",
        "enum": [
          "leave_request",
          "access_request",
          "mentor_question"
        ]
      },
      "LeaveRequestParams": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "date_from",
          "date_to"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "day_off",
              "vacation"
            ],
            "description": "Отгул и отпуск — разные процессы"
          },
          "date_from": {
            "type": "string",
            "format": "date"
          },
          "date_to": {
            "type": "string",
            "format": "date"
          },
          "comment": {
            "type": "string",
            "maxLength": 500
          }
        }
      },
      "AccessRequestParams": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "system",
          "resource",
          "access_level",
          "justification"
        ],
        "properties": {
          "system": {
            "type": "string",
            "enum": [
              "jira",
              "confluence",
              "gitlab",
              "grafana",
              "redash",
              "kubernetes"
            ]
          },
          "resource": {
            "type": "string",
            "maxLength": 200,
            "description": "Проект Jira, пространство Confluence, репозиторий, дашборд и т.п."
          },
          "access_level": {
            "type": "string",
            "enum": [
              "read",
              "write",
              "admin"
            ]
          },
          "justification": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      },
      "MentorQuestionParams": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question"
        ],
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "context": {
            "type": "string",
            "maxLength": 2000,
            "description": "Что бот уже нашёл/почему не смог ответить (противоречие, нет документа)"
          }
        }
      },
      "ActionProposal": {
        "type": "object",
        "required": [
          "type",
          "params",
          "summary"
        ],
        "description": "Proposed by the AI. Never executed by the AI: Backend stores it as PendingAction and executes only after explicit user confirmation.",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/ActionType"
          },
          "params": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/LeaveRequestParams"
              },
              {
                "$ref": "#/components/schemas/AccessRequestParams"
              },
              {
                "$ref": "#/components/schemas/MentorQuestionParams"
              }
            ]
          },
          "summary": {
            "type": "string",
            "description": "Human-readable card text, e.g. 'Отгул 20.11.2026'"
          }
        }
      },
      "ServiceRequest": {
        "type": "object",
        "required": [
          "id",
          "number",
          "type",
          "status",
          "params",
          "created_at",
          "updated_at"
        ],
        "description": "A request created in a (mocked) corporate service: absence or access system.",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "number": {
            "type": "string",
            "examples": [
              "ABS-000123",
              "ACC-000045"
            ]
          },
          "type": {
            "type": "string",
            "enum": [
              "leave_request",
              "access_request"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pending_approval",
              "approved",
              "rejected"
            ]
          },
          "approver": {
            "type": "string",
            "description": "Роль/имя согласующего (руководитель, владелец проекта)"
          },
          "params": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/LeaveRequestParams"
              },
              {
                "$ref": "#/components/schemas/AccessRequestParams"
              }
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TaskContext": {
        "type": "object",
        "required": [
          "id",
          "title",
          "status",
          "checklist"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "description": "As stored by Backend (unavailable/active/submitted/completed/...)"
          },
          "checklist": {
            "type": "string",
            "enum": [
              "common",
              "professional"
            ]
          },
          "stage_title": {
            "type": "string"
          },
          "requires_result": {
            "type": "boolean"
          },
          "review_comment": {
            "type": "string",
            "description": "Последний комментарий наставника, если есть"
          }
        }
      },
      "UserContext": {
        "type": "object",
        "required": [
          "user_id",
          "role",
          "tasks",
          "open_requests",
          "allowed_actions"
        ],
        "description": "Verified by Backend from the JWT and DB. The AI trusts only this, never claims from chat text.",
        "properties": {
          "user_id": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "intern",
              "buddy"
            ]
          },
          "profession": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "backend",
              "frontend",
              "ml",
              null
            ]
          },
          "team": {
            "type": "string"
          },
          "buddy_name": {
            "type": "string"
          },
          "today": {
            "type": "string",
            "format": "date",
            "description": "Для разбора 'завтра', 'в пятницу'"
          },
          "current_stage": {
            "type": "object",
            "required": [
              "title",
              "position",
              "total"
            ],
            "properties": {
              "title": {
                "type": "string"
              },
              "position": {
                "type": "integer"
              },
              "total": {
                "type": "integer"
              }
            }
          },
          "tasks": {
            "type": "array",
            "maxItems": 30,
            "items": {
              "$ref": "#/components/schemas/TaskContext"
            },
            "description": "Active and next tasks first"
          },
          "open_requests": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "$ref": "#/components/schemas/ServiceRequest"
            }
          },
          "allowed_actions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ActionType"
            },
            "description": "RBAC: actions this user may perform. AI must not propose others."
          }
        }
      },
      "ChatTurn": {
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ]
          },
          "content": {
            "type": "string",
            "maxLength": 8000
          }
        }
      },
      "StatusEvent": {
        "type": "object",
        "required": [
          "stage"
        ],
        "properties": {
          "stage": {
            "type": "string",
            "enum": [
              "retrieving",
              "generating",
              "preparing_action"
            ]
          }
        }
      },
      "DeltaEvent": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string"
          }
        }
      },
      "SourcesEvent": {
        "type": "object",
        "required": [
          "sources"
        ],
        "properties": {
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Source"
            }
          }
        }
      },
      "DoneEvent": {
        "type": "object",
        "required": [
          "finish_reason",
          "mode"
        ],
        "properties": {
          "finish_reason": {
            "type": "string",
            "enum": [
              "answered",
              "no_answer",
              "action_proposed"
            ],
            "description": "no_answer = KB has no grounded answer (bot offered escalation)"
          },
          "mode": {
            "$ref": "#/components/schemas/AiMode"
          },
          "latency_ms": {
            "type": "integer"
          },
          "usage": {
            "type": "object",
            "properties": {
              "input_tokens": {
                "type": "integer"
              },
              "output_tokens": {
                "type": "integer"
              }
            }
          }
        }
      },
      "ErrorEvent": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "llm_unavailable",
              "timeout",
              "internal"
            ]
          },
          "message": {
            "type": "string",
            "description": "Safe to show to the user"
          }
        }
      },
      "StreamChatRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "\\S"
          },
          "conversation_id": {
            "type": "string",
            "format": "uuid",
            "description": "Omit to start a new conversation"
          }
        }
      },
      "MetaEvent": {
        "type": "object",
        "required": [
          "conversation_id",
          "message_id"
        ],
        "properties": {
          "conversation_id": {
            "type": "string",
            "format": "uuid"
          },
          "message_id": {
            "type": "string",
            "format": "uuid",
            "description": "Id of the assistant message being streamed"
          }
        }
      },
      "PendingAction": {
        "type": "object",
        "required": [
          "id",
          "type",
          "params",
          "summary",
          "status",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "$ref": "#/components/schemas/ActionType"
          },
          "params": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/LeaveRequestParams"
              },
              {
                "$ref": "#/components/schemas/AccessRequestParams"
              },
              {
                "$ref": "#/components/schemas/MentorQuestionParams"
              }
            ]
          },
          "summary": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "executed",
              "cancelled",
              "failed"
            ]
          },
          "error": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "BackendActionEvent": {
        "type": "object",
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "$ref": "#/components/schemas/PendingAction"
          }
        }
      },
      "ActionResult": {
        "type": "object",
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "$ref": "#/components/schemas/PendingAction"
          },
          "request": {
            "$ref": "#/components/schemas/ServiceRequest"
          },
          "mentor_question": {
            "$ref": "#/components/schemas/MentorQuestion"
          }
        }
      },
      "MentorQuestion": {
        "type": "object",
        "required": [
          "id",
          "intern_id",
          "question",
          "status",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "intern_id": {
            "type": "string",
            "format": "uuid"
          },
          "intern_name": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "context": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "answered"
            ]
          },
          "answer": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "answered_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ChatMessage": {
        "type": "object",
        "required": [
          "id",
          "role",
          "content",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ]
          },
          "content": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Source"
            }
          },
          "action": {
            "$ref": "#/components/schemas/PendingAction"
          },
          "finish_reason": {
            "type": "string"
          },
          "feedback": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "up",
              "down",
              null
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Feedback": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rating"
        ],
        "properties": {
          "rating": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ]
          }
        }
      },
      "AnswerMentorQuestion": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "answer"
        ],
        "properties": {
          "answer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        }
      },
      "ChatMetrics": {
        "type": "object",
        "description": "Product metrics for the demo dashboard / presentation",
        "properties": {
          "questions_total": {
            "type": "integer"
          },
          "answered_by_bot": {
            "type": "integer"
          },
          "escalated_to_mentor": {
            "type": "integer"
          },
          "deflection_rate": {
            "type": "number",
            "description": "1 - escalated/questions"
          },
          "thumbs_up": {
            "type": "integer"
          },
          "thumbs_down": {
            "type": "integer"
          },
          "actions_executed": {
            "type": "integer"
          },
          "estimated_mentor_minutes_saved": {
            "type": "number"
          }
        }
      },
      "BackendStreamEvent": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/StatusEvent"
          },
          {
            "$ref": "#/components/schemas/DeltaEvent"
          },
          {
            "$ref": "#/components/schemas/SourcesEvent"
          },
          {
            "$ref": "#/components/schemas/BackendActionEvent"
          },
          {
            "$ref": "#/components/schemas/DoneEvent"
          },
          {
            "$ref": "#/components/schemas/ErrorEvent"
          },
          {
            "$ref": "#/components/schemas/MetaEvent"
          }
        ]
      }
    }
  }
}
